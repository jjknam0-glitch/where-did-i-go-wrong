# --- Transcription (the only AI step). Set ONE key; the provider is picked automatically. ---
ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Optional: choose a provider (anthropic | gemini | openai | auto)
# TRANSCRIBE_PROVIDER=auto
# Optional: the two reads of each line, ideally two different models. Entries can name a
# provider, e.g. "anthropic:claude-haiku-5-5,gemini:gemini-2.5-flash".
# READ_MODELS=claude-haiku-5-5,claude-sonnet-5-5
# A stronger model, called only for lines where the two reads disagree ("none" to disable).
# TIEBREAK_MODEL=claude-opus-5-5
# AI-phrased hints (always verified by the math engine; set 0 to use template hints only)
# AI_HINTS=1

# --- Server ---
# Comma-separated origins allowed to call the API (your Vercel URL in production)
CORS_ORIGINS=*
# ENGINE_WORKERS=4
# DATA_DIR=./data
